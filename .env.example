# Supabase (local values come from `supabase start` output)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: embeddings + categorization fallback (no-training API terms; named
# on the privacy page). Optional — without it, links are archived but not
# categorized or semantically searchable.
OPENAI_API_KEY=

# Shared secret between the scheduled function and /api/jobs/* endpoints.
CRON_SECRET=

# Google Safe Browsing (optional; held links never surface)
SAFE_BROWSING_API_KEY=

# Comma-separated emails that can manage beta invites at /admin/invites
ADMIN_EMAILS=

# Feature flag: groups. Off unless exactly "true".
GROUPS_ENABLED=

# Resend API key (sending only) for the emails Radar sends itself: sign-up
# links for people joining from a group invite link. Supabase's sign-in
# emails go through Resend SMTP, configured in the Supabase dashboard. Without
# it, local dev prints sign-up links to the server log; production refuses
# new sign-ups from invite links.
RESEND_API_KEY=
# Optional: sender for those emails (default: On Your Radar <hello@mail.onyourradar.app>)
MAIL_FROM=
# Optional: secret for signing sign-up links (default: derived from SUPABASE_SERVICE_ROLE_KEY)
SIGNUP_LINK_SECRET=
