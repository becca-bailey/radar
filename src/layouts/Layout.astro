---
import '../styles/global.css';

interface Props {
  title?: string;
  user?: import('@supabase/supabase-js').User | null;
}

const { title = 'Rabbit Hole', user } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header class="site">
        <a class="brand" href="/">Rabbit Hole</a>
        <nav>
          {
            user ? (
              <>
                <a href="/search">Search</a>
                <a href="/settings">Settings</a>
                <form method="post" action="/api/auth/logout" style="display:inline">
                  <button class="quiet" type="submit">
                    Sign out
                  </button>
                </form>
              </>
            ) : (
              <a href="/login">Sign in</a>
            )
          }
        </nav>
      </header>
      <slot />
      <footer style="margin-top:3rem; padding-top:1rem; border-top:1px solid var(--border); font-size:0.85rem; color:var(--muted)">
        <a href="/privacy">Privacy</a> · Your archive is yours: export it any time.
      </footer>
    </main>
  </body>
</html>
