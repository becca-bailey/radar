---
import '../styles/global.css';
import UserMenu from '@/components/UserMenu.tsx';
import { isAdmin } from '../lib/admin';
import { MODE_COOKIE, THEME_COLORS, THEME_COOKIE, THEME_FONTS, resolveMode, resolveTheme } from '../lib/theme';

interface Props {
  title?: string;
  description?: string;
  user?: import('@supabase/supabase-js').User | null;
}

const { title = 'Radar', description, user } = Astro.props;

// Theme and mode are chosen here, on the server, so the first paint is
// already right (src/lib/theme.ts). Cookies are untrusted; resolve* only
// lets known values through.
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE)?.value);
const mode = resolveMode(Astro.cookies.get(MODE_COOKIE)?.value);
const themeColors = THEME_COLORS[theme];

// "4 new" on the Groups link: shares from others since your last visit to
// each group. A quiet count, not a notification; visiting clears it.
let groupNews = 0;
if (user) {
  const { data } = await Astro.locals.supabase.rpc('my_group_news');
  groupNews = ((data ?? []) as { new_count: number }[]).reduce((n, r) => n + r.new_count, 0);
}
---

<!doctype html>
<html lang="en" data-theme={theme} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      mode === 'system' ? (
        <>
          <meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)" />
        </>
      ) : (
        <meta name="theme-color" content={themeColors[mode]} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={THEME_FONTS[theme]} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Tell the server this browser's time zone so dates render in it
      // (src/lib/dates.ts). Written only when it changes.
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz && document.cookie.split('; ').indexOf('tz=' + encodeURIComponent(tz)) === -1) {
          document.cookie =
            'tz=' + encodeURIComponent(tz) + '; path=/; max-age=31536000; samesite=lax' +
            (location.protocol === 'https:' ? '; secure' : '');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="relative min-h-svh" data-user-id={user?.id}>
    {/* Shown while a form submit waits on the server (src/scripts/submitting.ts). */}
    <div
      class="pointer-events-none fixed inset-x-0 top-0 z-50 hidden h-1 animate-pulse bg-gold [html:has(form[data-submitting])_&]:block"
      aria-hidden="true"
    ></div>
    {/*
      Background blobs. Not position: fixed: iOS Safari clips fixed elements
      to a viewport that stops short of its status bar and floating address
      bar, while page content scrolls under both, so fixed blobs showed a
      hard edge there (RAD-54). Instead, a viewport-tall sticky layer rides
      along with the scroll inside a page-sized clip box: it draws wherever
      content does, and the clip keeps the blobs from adding scroll overflow.
    */}
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-clip" aria-hidden="true">
      <div class="sticky top-0 h-lvh">
        <svg
          class="absolute -top-[60px] -right-20 w-[260px] text-pink opacity-30 min-[721px]:opacity-55"
          viewBox="0 0 200 200"
        >
          <path
            fill="currentColor"
            d="M48 15c25-14 62-18 84-2s24 48 17 76-23 54-49 62-61-4-77-27S5 66 17 44 32 24 48 15Z"></path>
        </svg>
        <svg
          class="absolute -bottom-[90px] -left-[100px] w-80 text-blue opacity-30 min-[721px]:opacity-55"
          viewBox="0 0 200 200"
        >
          <path
            fill="currentColor"
            d="M103 8c28 2 57 16 68 40s2 55-13 77-38 36-64 34S41 139 26 115 7 62 22 40 75 6 103 8Z"></path>
        </svg>
      </div>
    </div>
    <main class="relative mx-auto max-w-[660px] px-4 pt-4 pb-16">
      {/*
        On phones the logo, nav and avatar only just fit on one line, so
        below `sm` the wordmark, nav text and gaps shrink a little and the
        Groups badge becomes a dot (RAD-66). Narrower than that (about 340px),
        the nav wraps onto its own line, kept to the right by `ml-auto`.
      */}
      <header
        class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b-[3px] border-foreground py-3.5 max-sm:gap-x-3"
      >
        <a
          class="font-display font-wonk inline-flex items-center gap-[0.3em] text-[1.45rem] leading-[1.15] max-sm:text-[1.25rem] font-extrabold tracking-[-0.01em] text-foreground no-underline"
          href="/"
          aria-label="Radar"
        >
          {/* The logo (public/favicon.svg), drawn with theme colours so it dims in dark mode. */}
          <svg class="size-[1.3em] shrink-0" viewBox="26 26 460 460" aria-hidden="true">
            <circle cx="256" cy="256" r="220" fill="var(--peach)"></circle>
            <path d="M256 256 L256 36 A220 220 0 0 1 446.53 146 Z" fill="var(--blue)"></path>
            <g fill="none" stroke="var(--ink)" stroke-width="18">
              <circle cx="256" cy="256" r="76"></circle>
              <circle cx="256" cy="256" r="148"></circle>
              <circle cx="256" cy="256" r="220"></circle>
              <line x1="256" y1="256" x2="446.53" y2="146"></line>
            </g>
            <circle cx="256" cy="256" r="20" fill="var(--ink)"></circle>
            <circle cx="127.83" cy="330" r="36" fill="var(--peach)"></circle>
            <circle cx="127.83" cy="330" r="21" fill="var(--gold)" stroke="var(--ink)" stroke-width="18"
            ></circle>
          </svg>
          {/* Fraunces sits its x-height low in the line box; lift it so the wordmark centres on the mark (RAD-65). */}
          <span class="relative -top-[0.1em]">radar</span>
        </a>
        {/*
          Links carry a transparent border top and bottom, not just the bottom
          one the hover underline needs, so their text stays centred with the
          avatar and logo (RAD-65).
        */}
        <nav
          aria-label="Main"
          class="ml-auto flex items-center gap-3.5 text-[0.92rem] font-semibold max-sm:gap-2 max-sm:text-[0.85rem] [&_a]:border-y-[2.5px] [&_a]:border-transparent [&_a]:text-foreground [&_a]:no-underline [&_a:hover]:border-b-gold"
        >
          {
            user ? (
              <>
                <a href="/search">Search</a>
                <a href="/explore">Explore</a>
                <a href="/groups" aria-label={groupNews ? `Groups, ${groupNews} new` : undefined}>
                  Groups
                  {groupNews > 0 && (
                    <span
                      class="ml-1 inline-block min-w-5 rounded-full border-2 border-foreground bg-peach px-1 text-center text-[0.72rem] leading-4 text-ink max-sm:ml-0.5 max-sm:size-3 max-sm:min-w-0 max-sm:p-0 max-sm:align-top"
                      aria-hidden="true"
                    >
                      <span class="max-sm:hidden">{groupNews > 99 ? '99+' : groupNews}</span>
                    </span>
                  )}
                </a>
                <UserMenu client:load email={user.email ?? ''} admin={isAdmin(user)} />
              </>
            ) : (
              <>
                <a href="/about">About</a>
                <a href="/login">Sign in</a>
              </>
            )
          }
        </nav>
      </header>
      <slot />
      <footer class="mt-14 border-t-[3px] border-foreground pt-4 text-sm text-muted-foreground">
        <a href="/privacy">Privacy</a>
        {user && <> · <a href="/setup">Save from anywhere</a></>}
        {' '}· <a href="https://github.com/becca-bailey/radar">Source</a>
        {' '}· Your archive is yours: export it any time.
      </footer>
    </main>
    <script>
      import '../scripts/submitting';
      import { startOffline } from '../scripts/offline';

      // Offline copies of recent saves for a signed-in reader; cleared on
      // any signed-out page (RAD-25).
      startOffline(document.body.dataset.userId || null);
    </script>
  </body>
</html>
