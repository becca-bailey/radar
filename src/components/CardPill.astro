---
/** A small label on a card: "Picked", "Made by you", "Made by a member". */
interface Props {
  tone: 'success' | 'info';
  slot?: string;
}
const { tone } = Astro.props;
---

<span
  class:list={[
    'w-fit rounded-full border-2 px-2 text-[0.72rem] font-bold',
    tone === 'success' ? 'bg-success text-success-foreground' : 'bg-info text-info-foreground',
  ]}
>
  <slot />
</span>
