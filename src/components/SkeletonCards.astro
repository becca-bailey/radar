---
// Placeholder cards for content a form is about to create. Hidden until the
// form with id `for` is submitted (src/scripts/submitting.ts reveals it).
import { Card } from '@/components/ui/card';
import { Skeleton } from '@/components/ui/skeleton';

interface Props {
  /** The id of the form whose submit reveals this. */
  for: string;
  count?: number;
  /** Also show a heading line, as above a lens section. */
  heading?: boolean;
  class?: string;
}

const { for: formId, count = 2, heading = false, class: className } = Astro.props;
---

<div data-skeleton-for={formId} class={className} aria-hidden="true" hidden>
  {
    heading && (
      <div class="mb-4 grid gap-2">
        <Skeleton className="h-7 w-1/2" />
        <Skeleton className="h-4 w-2/3" />
      </div>
    )
  }
  <div class="grid gap-3.5">
    {
      Array.from({ length: count }, () => (
        <Card>
          <div class="grid gap-2">
            <Skeleton className="h-5 w-4/5" />
            <Skeleton className="h-4 w-2/5" />
          </div>
        </Card>
      ))
    }
  </div>
</div>
