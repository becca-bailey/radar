---
import { Alert } from '@/components/ui/alert';

/**
 * "Deleted. Undo" after a save is deleted (the delete action adds
 * ?deleted=1&trash=<id>), and "Restored." after undoing. Undo returns to
 * the same page, minus these flags.
 */
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const params = Astro.url.searchParams;
const trash = params.get('trash');
const trashId = trash && UUID_RE.test(trash) ? trash : null;
const restored = params.get('restored') === '1';

const back = new URL(Astro.url);
for (const key of ['deleted', 'trash', 'restored', 'error']) back.searchParams.delete(key);
const returnPath = back.pathname + back.search;
---

{
  trashId && params.get('deleted') === '1' && (
    <Alert>
      <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
        Deleted.
        <form method="post" action="/api/saves/restore">
          <input type="hidden" name="trash_id" value={trashId} />
          <input type="hidden" name="return_path" value={returnPath} />
          <button class="cursor-pointer font-semibold underline" type="submit">Undo</button>
        </form>
      </span>
    </Alert>
  )
}
{restored && <Alert>Restored.</Alert>}
