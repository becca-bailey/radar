---
import { Card, CardAction, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

/**
 * One row in a CardList: a title (optionally a link), a muted meta line, an
 * optional top-right action (e.g. a menu), and free-form body content.
 *
 * Slots: `before` (above the title), `meta`, `action`, default (body).
 */
interface Props {
  title?: string | null;
  href?: string | null;
  /** Media kind for the corner dot. Articles (the default) stay quiet. */
  kind?: string | null;
  /** Thumbnail URL, shown as a small image on the card's right edge. */
  thumb?: string | null;
  [attr: `data-${string}`]: string | undefined;
}

const { title, href, kind, thumb, ...attrs } = Astro.props;

// Conditional children often render nothing; skip the body wrapper then.
const body = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';

// Corner dot: media kind. The kind is also written in the meta line, so
// color is never the only signal.
const DOT_SHAPES: Record<string, string> = {
  video: 'rotate-[8deg] rounded-[50%_50%_50%_4px] bg-candy-sky',
  audio: 'rotate-[8deg] rounded-[50%_4px_50%_50%] bg-candy-plum',
  product: '-rotate-6 rounded-[4px_50%_50%_50%] bg-candy-lime',
  other: 'rotate-[14deg] rounded-[50%_50%_50%_4px] bg-candy-pink',
};
const dot = (kind && DOT_SHAPES[kind]) || 'rotate-[8deg] rounded-[50%_50%_50%_4px] bg-card';
---

<li {...attrs}>
  <Card>
    <span
      aria-hidden="true"
      class:list={['absolute -top-[7px] right-3.5 size-[15px] border-2', dot]}></span>
    <div class="flex items-start gap-3">
      {
        thumb && (
          <img
            class="mt-1 h-12 w-16 shrink-0 rounded-md sm:h-[60px] sm:w-[88px] border-2 border-border object-cover shadow-hard-xs"
            src={thumb}
            alt=""
            loading="lazy"
            referrerpolicy="no-referrer"
            onerror="this.style.display='none'"
          />
        )
      }
      <div class="flex min-w-0 flex-1 flex-col gap-2">
        <CardHeader>
          <slot name="before" />
          {
            title && (
              <CardTitle>
                {href ? (
                  <a
                    class="text-foreground no-underline decoration-candy-orange decoration-[3px] hover:underline"
                    href={href}
                  >
                    {title}
                  </a>
                ) : (
                  title
                )}
              </CardTitle>
            )
          }
          {
            Astro.slots.has('meta') && (
              <CardDescription>
                <slot name="meta" />
              </CardDescription>
            )
          }
          {
            Astro.slots.has('action') && (
              <CardAction>
                <slot name="action" />
              </CardAction>
            )
          }
        </CardHeader>
        {body && <CardContent set:html={body} />}
      </div>
    </div>
  </Card>
</li>
