---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';

if (Astro.locals.user) {
  return Astro.redirect('/');
}

const sent = Astro.url.searchParams.get('sent') === '1';
const accountDeleted = Astro.url.searchParams.get('account_deleted') === '1';
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '';
---

<Layout title="Sign in — Radar">
  <h1>Sign in</h1>
  <p>Enter your email and we'll send you a sign-in link. No password.</p>

  {sent && (
    <Alert>
      Check your email for the sign-in link.
      {import.meta.env.DEV && (
        <>
          {' '}In local dev, mail lands at <a href="http://localhost:55324">localhost:55324</a>.
        </>
      )}
    </Alert>
  )}
  {accountDeleted && <Alert>Your account and archive were deleted.</Alert>}
  {error && <Alert variant="error">{error}</Alert>}

  <form class="mt-4 mb-6 grid gap-2.5" method="post" action="/api/auth/login">
    <input type="hidden" name="next" value={next} />
    <Input type="email" name="email" placeholder="you@example.com" required autoFocus />
    <Button type="submit">Send sign-in link</Button>
  </form>
</Layout>
