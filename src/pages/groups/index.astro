---
import Layout from '../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import { Label } from '@/components/ui/label';
import { cleanMemberName, MEMBER_NAME_MAX } from '../../lib/memberNames';

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

let message: string | null = null;
// The create form keeps what was typed after a failed submit.
let typedGroupName = '';
let typedMemberName: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim().slice(0, 100);
  const memberName = cleanMemberName(form.get('display_name'));
  typedGroupName = name;
  typedMemberName = String(form.get('display_name') ?? '');
  if (!name) {
    message = 'Give the group a name.';
  } else if (!memberName) {
    message = 'Pick a name for yourself in this group.';
  } else {
    // Creates the group and your membership, with your name, in one step.
    const { data: groupId, error } = await supabase.rpc('create_group', {
      group_name: name,
      member_name: memberName,
    });
    if (error || !groupId) {
      message = `Could not create the group: ${error?.message ?? 'try again.'}`;
    } else {
      return Astro.redirect(`/groups/${groupId as string}`);
    }
  }
}

const [{ data: groups }, { data: news }, { data: profile }] = await Promise.all([
  supabase.from('groups').select('id, name, owner_id').order('created_at', { ascending: true }),
  supabase.rpc('my_group_news'),
  supabase.from('profiles').select('display_name').eq('id', user.id).maybeSingle(),
]);
// Your default name from settings pre-fills your name in a new group.
const memberNameValue = typedMemberName ?? ((profile?.display_name as string | undefined) ?? '');
const newIn = new Map(((news ?? []) as { group_id: string; new_count: number }[]).map((r) => [r.group_id, r.new_count]));
---

<Layout title="Groups — Radar" user={user}>
  <h1>Groups</h1>
  <p>
    A group is a shared pool of links. Members share saves from their archive with a
    short note of why, under the name they picked for that group. The owner sets up topics to browse
    by, and anyone can export the links, say for a newsletter's links post. No comments,
    no likes, no feed.
  </p>

  {message && <Alert variant="error">{message}</Alert>}

  {
    (groups ?? []).length > 0 && (
      <CardList>
        {(groups ?? []).map((g) => (
          <ItemCard href={`/groups/${g.id}`} title={g.name}>
            <Fragment slot="meta">
              {[g.owner_id === user.id ? 'You run this' : '', newIn.get(g.id) ? `${newIn.get(g.id)} new since your last visit` : '']
                .filter(Boolean)
                .join(' · ')}
            </Fragment>
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Start a group</h2>
  <form class="mt-4 mb-6 grid gap-2.5" method="post">
    <Label htmlFor="new-group-name">Group name</Label>
    <Input id="new-group-name" type="text" name="name" defaultValue={typedGroupName} required maxLength={100} />
    <Label className="mt-2" htmlFor="new-group-member-name">Your name in this group</Label>
    <Input
      id="new-group-member-name"
      type="text"
      name="display_name"
      defaultValue={memberNameValue}
      required
      maxLength={MEMBER_NAME_MAX}
      autoComplete="nickname"
      aria-describedby="new-group-member-name-hint"
    />
    <p id="new-group-member-name-hint" class="m-0 text-sm text-muted-foreground">
      Shown on what you share there. It doesn't have to be your real name.
    </p>
    <Button type="submit">Create group</Button>
  </form>
</Layout>
