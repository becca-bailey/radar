---
import Layout from '../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import { groupsEnabled } from '../../lib/flags';

if (!groupsEnabled()) {
  return Astro.redirect('/');
}

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  if (!name) {
    message = 'Give the group a name.';
  } else {
    const { data: group, error } = await supabase
      .from('groups')
      .insert({ name, owner_id: user.id })
      .select('id')
      .single();
    if (error) {
      message = `Could not create group: ${error.message}`;
    } else {
      return Astro.redirect(`/groups/${group.id}`);
    }
  }
}

const { data: groups } = await supabase
  .from('groups')
  .select('id, name, cadence, edition_size, owner_id')
  .order('created_at', { ascending: true });
---

<Layout title="Groups — Radar" user={user}>
  <h1>Groups</h1>
  <p>
    A group is a few people who trust each other's taste. Share a save with a
    short note of why; the group publishes a finite edition on a fixed cadence. No
    comments, no likes, no feed.
  </p>

  {message && <Alert variant="error">{message}</Alert>}

  {
    (groups ?? []).length > 0 && (
      <CardList>
        {(groups ?? []).map((g) => (
          <ItemCard href={`/groups/${g.id}`} title={g.name}>
            <Fragment slot="meta">
              {g.cadence} · {g.edition_size} links per edition
              {g.owner_id === user.id ? ' · you run this' : ''}
            </Fragment>
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Start a group</h2>
  <form class="mt-4 mb-6 grid gap-2.5" method="post">
    <Input type="text" name="name" placeholder="Group name" required maxLength={100} />
    <Button type="submit">Create group</Button>
  </form>
</Layout>
