---
import Layout from '../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import { groupsEnabled } from '../../lib/flags';

if (!groupsEnabled()) {
  return Astro.redirect('/');
}

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  if (!name) {
    message = 'Give the group a name.';
  } else {
    const { data: group, error } = await supabase
      .from('groups')
      .insert({ name, owner_id: user.id })
      .select('id')
      .single();
    if (error) {
      message = `Could not create group: ${error.message}`;
    } else {
      return Astro.redirect(`/groups/${group.id}`);
    }
  }
}

const [{ data: groups }, { data: news }] = await Promise.all([
  supabase.from('groups').select('id, name, owner_id').order('created_at', { ascending: true }),
  supabase.rpc('my_group_news'),
]);
const newIn = new Map(((news ?? []) as { group_id: string; new_count: number }[]).map((r) => [r.group_id, r.new_count]));
---

<Layout title="Groups — Radar" user={user}>
  <h1>Groups</h1>
  <p>
    A group is a shared pool of links. Members share saves from their archive with a
    short note of why; shares are anonymous unless someone picks a name for that group. The owner sets up topics to browse
    by, and anyone can export the links, say for a newsletter's links post. No comments,
    no likes, no feed.
  </p>

  {message && <Alert variant="error">{message}</Alert>}

  {
    (groups ?? []).length > 0 && (
      <CardList>
        {(groups ?? []).map((g) => (
          <ItemCard href={`/groups/${g.id}`} title={g.name}>
            <Fragment slot="meta">
              {[g.owner_id === user.id ? 'You run this' : '', newIn.get(g.id) ? `${newIn.get(g.id)} new since your last visit` : '']
                .filter(Boolean)
                .join(' · ')}
            </Fragment>
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Start a group</h2>
  <form class="mt-4 mb-6 grid gap-2.5" method="post">
    <Input type="text" name="name" placeholder="Group name" required maxLength={100} />
    <Button type="submit">Create group</Button>
  </form>
</Layout>
