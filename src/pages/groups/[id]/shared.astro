---
import Layout from '../../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import PoolCard from '@/components/PoolCard.astro';
import { fetchGroupPool, pageOf, parsePage } from '../../../lib/groupPool';

/**
 * Everything shared to a group, newest first, in numbered pages with Newer /
 * Older links. Finite pages, never a feed that loads more (PLAN.md §2).
 */
const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const groupId = Astro.params.id!;
const home = `/groups/${groupId}`;
// RLS: members only.
const { data: group } = await supabase.from('groups').select('id, name, owner_id').eq('id', groupId).maybeSingle();
if (!group) {
  return Astro.redirect('/groups');
}
const isOwner = group.owner_id === user.id;

const PER_PAGE = 30;
// group_pool has no offset, so a page fetches everything newer than it too.
// Past this, Export (by date) is the way back.
const MAX_PAGE = 30;

const params = Astro.url.searchParams;
const page = parsePage(params.get('page'), MAX_PAGE);
const pagePath = (n: number) => `${home}/shared${n > 1 ? `?page=${n}` : ''}`;
// One URL per page: send an out-of-range or junk ?page= to the page it shows.
if ((params.get('page') ?? '1') !== String(page) && !params.has('removed') && !params.has('error')) {
  return Astro.redirect(pagePath(page));
}

const { links, error: poolError } = await fetchGroupPool(supabase, group.id, { limit: page * PER_PAGE + 1 });
const { items, hasOlder } = pageOf(links, page, PER_PAGE);

const notice = params.get('removed') === '1' ? 'Removed from the group.' : null;
const error = params.get('error') ?? poolError;
---

<Layout title={`Shared — ${group.name} — Radar`} user={user}>
  <p class="mb-0 text-sm"><a class="text-muted-foreground" href={home}>← {group.name}</a></p>
  <h1>Everything shared</h1>
  <p class="m-0 text-sm text-muted-foreground">
    Newest first{page > 1 ? ` · Page ${page}` : ''}.
  </p>

  {notice && <Alert>{notice}</Alert>}
  {error && <Alert variant="error">{error}</Alert>}

  {
    items.length === 0 && !poolError ? (
      page > 1 ? (
        <Empty>
          No more shares. <a href={pagePath(1)}>Back to the newest</a>.
        </Empty>
      ) : (
        <Empty>
          Nothing shared yet. Share a save from your <a href="/">archive</a> with a note of why.
        </Empty>
      )
    ) : (
      <CardList>
        {items.map((l) => (
          <PoolCard link={l} groupId={group.id} isOwner={isOwner} returnPath={pagePath(page)} />
        ))}
      </CardList>
    )
  }

  {
    items.length > 0 && (page > 1 || hasOlder) && (
      <nav class="mt-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t-2 pt-4" aria-label="Pages">
        {page > 1 ? <a class="font-semibold" href={pagePath(page - 1)} rel="prev">← Newer</a> : <span />}
        {hasOlder && page < MAX_PAGE && (
          <a class="font-semibold" href={pagePath(page + 1)} rel="next">Older →</a>
        )}
      </nav>
    )
  }
  {
    hasOlder && page >= MAX_PAGE && (
      <p class="mt-3 text-sm text-muted-foreground">
        For older shares, use <a href={`${home}/export`}>Export</a>, which picks by date.
      </p>
    )
  }
</Layout>
