---
import Layout from '../../../layouts/Layout.astro';
import { NativeSelect } from '@/components/ui/native-select';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import Why from '@/components/Why.astro';
import { groupsEnabled } from '../../../lib/flags';
import { createServiceClient } from '../../../lib/supabase';

if (!groupsEnabled()) {
  return Astro.redirect('/');
}

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const groupId = Astro.params.id!;
let message: string | null = null;

// --- Load group (RLS: members only) ---------------------------------------
const { data: group } = await supabase
  .from('groups')
  .select('id, name, owner_id, cadence, edition_size, names_visible, contribute_public, per_source_cap')
  .eq('id', groupId)
  .maybeSingle();

if (!group) {
  return Astro.redirect('/groups');
}
const isOwner = group.owner_id === user.id;

// --- Handle actions ---------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');

  if (action === 'settings' && isOwner) {
    const { error } = await supabase
      .from('groups')
      .update({
        name: String(form.get('name') ?? group.name).trim() || group.name,
        cadence: String(form.get('cadence') ?? group.cadence),
        edition_size: Number(form.get('edition_size') ?? group.edition_size),
        names_visible: form.get('names_visible') === 'on',
        contribute_public: form.get('contribute_public') === 'on',
        per_source_cap: Number(form.get('per_source_cap') ?? group.per_source_cap),
      })
      .eq('id', group.id);
    message = error ? `Could not save settings: ${error.message}` : 'Settings saved.';
    if (!error) return Astro.redirect(`/groups/${group.id}?saved=1`);
  }

  if (action === 'rotate_invite' && isOwner) {
    // Service role: deactivate old, create new (one active per group).
    const service = createServiceClient();
    await service.from('invite_links').update({ active: false }).eq('group_id', group.id).eq('active', true);
    const { error } = await service.from('invite_links').insert({
      group_id: group.id,
      weekly_cap: Number(form.get('weekly_cap') ?? 50) || 50,
    });
    message = error ? `Could not rotate link: ${error.message}` : 'New invite link active; the old one is dead.';
  }

  if (action === 'invite_cap' && isOwner) {
    const { error } = await supabase
      .from('invite_links')
      .update({ weekly_cap: Number(form.get('weekly_cap') ?? 50) || 50, paused_at: null })
      .eq('group_id', group.id)
      .eq('active', true);
    message = error ? `Could not update cap: ${error.message}` : 'Invite cap updated.';
  }

  if (action === 'remove_member' && isOwner) {
    const memberId = String(form.get('user_id'));
    if (memberId === group.owner_id) {
      message = 'The owner cannot be removed.';
    } else {
      // Remove membership and their recommendations here; past editions are
      // immutable snapshots and keep what they published.
      await supabase.from('recommendations').delete().eq('group_id', group.id).eq('user_id', memberId);
      const { error } = await supabase
        .from('memberships')
        .delete()
        .eq('group_id', group.id)
        .eq('user_id', memberId);
      message = error ? `Could not remove member: ${error.message}` : 'Member removed.';
    }
  }

  if (action === 'leave' && !isOwner) {
    await supabase.from('recommendations').delete().eq('group_id', group.id).eq('user_id', user.id);
    await supabase.from('memberships').delete().eq('group_id', group.id).eq('user_id', user.id);
    return Astro.redirect('/groups');
  }
}

if (Astro.url.searchParams.get('saved') === '1') message = 'Settings saved.';

// --- Load page data ---------------------------------------------------------
const [{ data: members }, { data: recs }, { data: editions }, inviteRes] = await Promise.all([
  supabase
    .from('memberships')
    .select('user_id, role, created_at, profiles:user_id(display_name)')
    .eq('group_id', group.id)
    .order('created_at'),
  supabase
    .from('recommendations')
    .select('id, note, created_at, user_id, links(title, canonical_url, source), profiles:user_id(display_name)')
    .eq('group_id', group.id)
    .order('created_at', { ascending: false })
    .limit(50),
  supabase
    .from('editions')
    .select('id, period_start, period_end, published_at')
    .eq('group_id', group.id)
    .order('period_start', { ascending: false })
    .limit(20),
  isOwner
    ? supabase
        .from('invite_links')
        .select('token, weekly_cap, uses_this_week, paused_at')
        .eq('group_id', group.id)
        .eq('active', true)
        .maybeSingle()
    : Promise.resolve({ data: null }),
]);

const invite = inviteRes.data as {
  token: string;
  weekly_cap: number;
  uses_this_week: number;
  paused_at: string | null;
} | null;

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

type RecRow = {
  id: string;
  note: string | null;
  created_at: string;
  user_id: string;
  links: { title: string | null; canonical_url: string; source: string | null } | null;
  profiles: { display_name: string } | null;
};
const recRows = (recs ?? []) as unknown as RecRow[];
type MemberRow = {
  user_id: string;
  role: string;
  profiles: { display_name: string } | null;
};
const memberRows = (members ?? []) as unknown as MemberRow[];
---

<Layout title={`${group.name} — Radar`} user={user}>
  <h1>{group.name}</h1>
  <p class="text-[0.82rem] text-muted-foreground">
    {group.cadence} editions of {group.edition_size} · {memberRows.length} member{memberRows.length === 1 ? '' : 's'}
  </p>

  {message && <Alert>{message}</Alert>}

  <h2>Editions</h2>
  {
    (editions ?? []).length === 0 ? (
      <Empty>No editions yet. The first one publishes on the group's cadence.</Empty>
    ) : (
      <CardList>
        {(editions ?? []).map((e) => (
          <ItemCard href={`/groups/${group.id}/editions/${e.id}`} title={`${dateFmt.format(new Date(e.period_start))} – ${dateFmt.format(new Date(e.period_end))}`}>
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Shared this period</h2>
  {
    recRows.length === 0 ? (
      <Empty>Nothing shared yet. Share a save from your <a href="/">archive</a>.</Empty>
    ) : (
      <CardList>
        {recRows.map((r) => (
          <ItemCard href={r.links?.canonical_url} title={r.links?.title ?? r.links?.canonical_url}>
            <Fragment slot="meta">
              {r.links?.source ?? ''}
              {group.names_visible && r.profiles?.display_name ? ` · ${r.profiles.display_name}` : ''}
              {' · '}
              {dateFmt.format(new Date(r.created_at))}
            </Fragment>
            {r.note && <Why>{r.note}</Why>}
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Members</h2>
  <CardList>
    {
      memberRows.map((m) => (
        <ItemCard>
          <div class="flex items-center justify-between gap-2">
          <span>
            {m.profiles?.display_name || 'Unnamed reader'}
            {m.role === 'owner' ? ' (owner)' : ''}
          </span>
          {isOwner && m.user_id !== group.owner_id && (
            <form method="post">
              <input type="hidden" name="_action" value="remove_member" />
              <input type="hidden" name="user_id" value={m.user_id} />
              <Button variant="destructive" type="submit">
                Remove
              </Button>
            </form>
          )}
          </div>
        </ItemCard>
      ))
    }
  </CardList>

  {
    !isOwner && (
      <form class="mt-2" method="post">
        <input type="hidden" name="_action" value="leave" />
        <Button variant="destructive" type="submit">
          Leave group
        </Button>
      </form>
    )
  }

  {
    isOwner && (
      <>
        <h2>Invite link</h2>
        {invite ? (
          <>
            <code class="block rounded-md border-2 border-dashed bg-background p-2.5 text-[0.88rem] wrap-anywhere select-all">{`${Astro.url.origin}/join/${invite.token}`}</code>
            <p class="text-[0.82rem] text-muted-foreground">
              {invite.uses_this_week} of {invite.weekly_cap} uses this week
              {invite.paused_at ? ' · paused (cap reached)' : ''}
            </p>
            <form class="mt-4 mb-6 grid gap-2.5" method="post">
              <input type="hidden" name="_action" value="invite_cap" />
              <label class="grid gap-1 text-[0.92rem] font-semibold">
                Weekly cap
                <Input type="text" name="weekly_cap" defaultValue={String(invite.weekly_cap)} inputMode="numeric" />
              </label>
              <Button variant="outline" type="submit">Update cap</Button>
            </form>
          </>
        ) : (
          <p>No active invite link.</p>
        )}
        <form class="mt-2" method="post">
          <input type="hidden" name="_action" value="rotate_invite" />
          <input type="hidden" name="weekly_cap" value={String(invite?.weekly_cap ?? 50)} />
          <Button variant="outline" type="submit">
            {invite ? 'Rotate link (kills the old one immediately)' : 'Create invite link'}
          </Button>
        </form>

        <h2>Settings</h2>
        <form class="mt-4 mb-6 grid gap-2.5" method="post">
          <input type="hidden" name="_action" value="settings" />
          <label class="grid gap-1 text-[0.92rem] font-semibold">
            Name
            <Input type="text" name="name" defaultValue={group.name} maxLength={100} />
          </label>
          <label class="grid gap-1 text-[0.92rem] font-semibold">
            Cadence
            <NativeSelect name="cadence">
              <option value="daily" selected={group.cadence === 'daily'}>Daily</option>
              <option value="weekly" selected={group.cadence === 'weekly'}>Weekly</option>
              <option value="biweekly" selected={group.cadence === 'biweekly'}>Biweekly</option>
            </NativeSelect>
          </label>
          <label class="grid gap-1 text-[0.92rem] font-semibold">
            Links per edition (K)
            <Input type="text" name="edition_size" defaultValue={String(group.edition_size)} inputMode="numeric" />
          </label>
          <label class="grid gap-1 text-[0.92rem] font-semibold">
            Max links per source per edition
            <NativeSelect name="per_source_cap">
              <option value="1" selected={group.per_source_cap === 1}>1</option>
              <option value="2" selected={group.per_source_cap === 2}>2</option>
            </NativeSelect>
          </label>
          <label class="flex items-center gap-2 text-sm font-semibold">
            <input class="size-4 accent-primary" type="checkbox" name="names_visible" checked={group.names_visible} /> Show recommender names to
            members
          </label>
          <label class="flex items-center gap-2 text-sm font-semibold">
            <input class="size-4 accent-primary" type="checkbox" name="contribute_public" checked={group.contribute_public} /> Contribute
            anonymous counts to the public layer
          </label>
          <Button type="submit">Save settings</Button>
        </form>
      </>
    )
  }
</Layout>
