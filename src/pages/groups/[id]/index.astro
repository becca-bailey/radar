---
import Layout from '../../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button, buttonVariants } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import LensMenu from '@/components/LensMenu.tsx';
import PoolCard from '@/components/PoolCard.astro';
import OwnerPanel from '@/components/OwnerPanel.tsx';
import TopicSuggestions from '@/components/TopicSuggestions.tsx';
import { groupsEnabled } from '../../../lib/flags';
import { fetchGroupPool, type PoolLink } from '../../../lib/groupPool';
import { createServiceClient } from '../../../lib/supabase';

if (!groupsEnabled()) {
  return Astro.redirect('/');
}

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const groupId = Astro.params.id!;
const home = `/groups/${groupId}`;

// --- Load group (RLS: members only) ---------------------------------------
const { data: group } = await supabase
  .from('groups')
  .select('id, name, owner_id')
  .eq('id', groupId)
  .maybeSingle();

if (!group) {
  return Astro.redirect('/groups');
}
const isOwner = group.owner_id === user.id;
// The owner can preview the page as a member sees it: same data, none of
// the owner-only panels or controls.
const preview = isOwner && Astro.url.searchParams.get('view') === 'member';
const ownerView = isOwner && !preview;
/** Keep the member preview on while moving around the page. */
const withView = (path: string) => (preview ? `${path}${path.includes('?') ? '&' : '?'}view=member` : path);

// --- Handle actions ---------------------------------------------------------
// Each action redirects (post/redirect/get) with a short status flag.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const back = (flag: string, path = home) =>
    Astro.redirect(`${path}${path.includes('?') ? '&' : '?'}${flag}`);

  if (action === 'rename' && isOwner) {
    const name = String(form.get('name') ?? '').trim().slice(0, 100);
    if (!name) return back('error=' + encodeURIComponent('Give the group a name.'));
    const { error } = await supabase.from('groups').update({ name }).eq('id', group.id);
    return back(error ? 'error=' + encodeURIComponent('Could not rename the group.') : 'renamed=1');
  }

  if (action === 'rotate_invite' && isOwner) {
    // Service role: deactivate old, create new (one active per group).
    const service = createServiceClient();
    await service.from('invite_links').update({ active: false }).eq('group_id', group.id).eq('active', true);
    const { error } = await service.from('invite_links').insert({ group_id: group.id });
    return back(error ? 'error=' + encodeURIComponent('Could not make a new invite link.') : 'rotated=1');
  }

  if (action === 'remove_link' && isOwner) {
    // Moderation: mark the link's shares in this group as removed. Members'
    // saves, and their shares to other groups, are untouched. Removed links
    // can't be shared here again until restored.
    const linkId = String(form.get('link_id') ?? '');
    const rawReturn = String(form.get('return_path') ?? '');
    const returnPath = rawReturn === home || rawReturn.startsWith(`${home}?`) ? rawReturn : home;
    const { error } = await supabase.rpc('remove_link_from_group', { gid: group.id, lid: linkId });
    if (error) return back('error=' + encodeURIComponent('Could not remove the link. Try again.'), returnPath);
    return back('removed=1', returnPath);
  }

  if (action === 'restore_link' && isOwner) {
    const linkId = String(form.get('link_id') ?? '');
    const { error } = await supabase.rpc('restore_link_to_group', { gid: group.id, lid: linkId });
    return back(error ? 'error=' + encodeURIComponent('Could not restore the link.') : 'restored=1');
  }

  if (action === 'nickname') {
    const { error } = await supabase.rpc('set_group_display_name', {
      gid: group.id,
      name: String(form.get('display_name') ?? ''),
    });
    return back(error ? 'error=' + encodeURIComponent('Could not save your name.') : 'named=1');
  }

  if (action === 'leave' && !isOwner) {
    // RLS limits this to your own shares; the saves stay in your archive.
    await supabase.from('shares').delete().eq('group_id', group.id);
    await supabase.from('memberships').delete().eq('group_id', group.id).eq('user_id', user.id);
    return Astro.redirect('/groups');
  }

  return back('error=' + encodeURIComponent('Only the group owner can do that.'));
}

// --- Status messages --------------------------------------------------------
const params = Astro.url.searchParams;
const NOTICES: Record<string, string> = {
  created: 'Lens saved.',
  lens_updated: 'Lens updated.',
  deleted: 'Lens deleted.',
  renamed: 'Group renamed.',
  rotated: 'New invite link active; the old one stopped working.',
  removed: 'Removed from the group.',
  restored: 'Restored to the group.',
  named: 'Saved. Your name shows on what you share here.',
};
// Record this visit; the previous one draws "since your last visit". A
// lens view doesn't count as a visit to the group's front page.
const previousVisit: string | null = params.get('lens') || preview
  ? null
  : (((await supabase.rpc('mark_group_visited', { gid: group.id })).data as string | null) ?? null);
const { data: myMembership } = await supabase
  .from('memberships')
  .select('display_name')
  .eq('group_id', group.id)
  .eq('user_id', user.id)
  .maybeSingle();
const myName = (myMembership?.display_name as string | null) ?? '';

const notice = Object.entries(NOTICES).find(([key]) => params.get(key) === '1')?.[1] ?? null;
const error = params.get('error');

// --- Lenses -----------------------------------------------------------------
interface Lens {
  id: string;
  name: string;
  query: string;
  query_embedding: string | null;
}

const { data: lensRows } = await supabase
  .from('lenses')
  .select('id, name, query, query_embedding')
  .eq('group_id', group.id)
  .order('created_at');
const lenses = (lensRows ?? []) as Lens[];

const single = lenses.find((l) => l.id === params.get('lens')) ?? null;
const shown = single ? [single] : lenses;
const newQuery = params.get('new');
const formOpen = ownerView && newQuery !== null;
// Prefilled from a suggested topic ("Make it a lens").
const newName = params.get('name');
const fromSuggestion = params.get('suggestion');

const LIMIT = 60;
const PREVIEW = 4;
const RECENT_DAYS = 7;
const RECENT_LIMIT = 30;

interface Section {
  lens: Lens;
  links: PoolLink[];
  total: number;
  error: string | null;
}

const recentFrom = new Date(Date.now() - RECENT_DAYS * 24 * 60 * 60 * 1000).toISOString();

const [sections, recent, ownerData] = await Promise.all([
  Promise.all(
    shown.map(async (lens): Promise<Section> => {
      const { links, error: poolError } = await fetchGroupPool(supabase, group.id, {
        query: lens.query,
        embedding: lens.query_embedding,
        limit: LIMIT,
      });
      return { lens, links: single ? links : links.slice(0, PREVIEW), total: links.length, error: poolError };
    })
  ),
  single
    ? Promise.resolve({ links: [] as PoolLink[], error: null })
    : fetchGroupPool(supabase, group.id, { limit: RECENT_LIMIT, sharedFrom: recentFrom }),
  isOwner && !single
    ? Promise.all([
        supabase.from('memberships').select('user_id', { count: 'exact', head: true }).eq('group_id', group.id),
        supabase
          .from('invite_links')
          .select('token, paused_at')
          .eq('group_id', group.id)
          .eq('active', true)
          .maybeSingle(),
        supabase.rpc('group_removed_links', { gid: group.id }),
      ])
    : Promise.resolve(null),
]);

const memberCount = ownerData?.[0].count ?? null;
const invite = (ownerData?.[1].data ?? null) as { token: string; paused_at: string | null } | null;
const removedLinks = (ownerData?.[2].data ?? []) as {
  link_id: string;
  title: string | null;
  canonical_url: string;
  removed_at: string;
}[];

// Split this week's shares at the last visit (none on a first visit).
const lastVisitMs = previousVisit ? new Date(previousVisit).getTime() : null;
const isNew = (l: PoolLink) => lastVisitMs !== null && new Date(l.last_shared_at).getTime() > lastVisitMs;
const recentNew = recent.links.filter(isNew);
const recentEarlier = recent.links.filter((l) => !isNew(l));

const returnPath = single ? `${home}?lens=${single.id}` : home;
const countLabel = (n: number) => `${n >= LIMIT ? `${LIMIT}+` : n} ${n === 1 ? 'link' : 'links'}`;
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Layout title={single ? `${single.name} — ${group.name} — Radar` : `${group.name} — Radar`} user={user}>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h1>{group.name}</h1>
    <a class={buttonVariants({ variant: 'outline', size: 'sm' })} href={`${home}/export`}>Export links</a>
  </div>
  {
    preview && (
      <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-lg border-2 bg-candy-plum px-4 py-2.5 shadow-hard-sm">
        <p class="m-0 text-sm font-semibold">You're previewing what members see.</p>
        <a class={buttonVariants({ variant: 'outline', size: 'sm' })} href={home}>Back to owner view</a>
      </div>
    )
  }
  {
    ownerView && !single && (
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-[0.85rem]">
        <span class="text-muted-foreground">
          You run this group{memberCount !== null ? ` · ${memberCount} member${memberCount === 1 ? '' : 's'}` : ''}
        </span>
        <a class="font-semibold" href={`${home}?view=member`}>Preview as a member</a>
        <a class="font-semibold" href="#owner-tools">Owner tools ↓</a>
      </div>
    )
  }
  <p class="text-[0.82rem] text-muted-foreground">
    Shares are anonymous unless the sharer picks a name for this group. Emails are never shown.
  </p>

  {notice && <Alert>{notice}</Alert>}
  {error && <Alert variant="error">{error}</Alert>}

  {single && (
    <p class="mt-4 mb-0 text-sm">
      <a class="text-muted-foreground" href={`${withView(home)}#lens-${single.id}`}>← {group.name}</a>
    </p>
  )}

  {
    !single && (
      <div class="mt-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <h2 class="m-0">Topics</h2>
        {ownerView && lenses.length > 0 && !formOpen && (
          <a class={buttonVariants({ variant: 'outline', size: 'sm' })} href={`${home}?new=`}>
            + New lens
          </a>
        )}
      </div>
    )
  }

  {
    !single && lenses.length === 0 && !formOpen && (
      ownerView ? (
        <Empty>
          Lenses are the topics members see: saved searches over everything shared here. Pick
          one from the suggestions below or <a href={`${home}?new=`}>add your own</a>.
        </Empty>
      ) : (
        <Empty>The owner hasn't set up any topics yet.</Empty>
      )
    )
  }

  {
    formOpen && (
      <form
        class="mt-5 mb-8 grid gap-2.5 rounded-lg border-2 bg-[color-mix(in_srgb,var(--candy-sky)_22%,var(--card))] p-4 shadow-hard"
        method="post"
        action="/api/lenses"
        id="new-lens"
      >
        <input type="hidden" name="group_id" value={group.id} />
        {fromSuggestion && <input type="hidden" name="suggestion" value={fromSuggestion} />}
        <h2 class="m-0 mb-0.5 text-[1.15rem]">{fromSuggestion && newName ? `Make “${newName}” a lens` : 'New lens'}</h2>
        {fromSuggestion && (
          <p class="m-0 text-sm text-muted-foreground">
            Change the search or the name first if you like. The suggestion goes away once it's a lens.
          </p>
        )}
        <div class="grid gap-1.5">
          <Label htmlFor="lens-query">Search for</Label>
          <Input
            id="lens-query"
            type="text"
            name="query"
            defaultValue={newQuery ?? ''}
            placeholder="knitting patterns, sourdough, essays about writing…"
            maxLength={200}
            required
            autoFocus
          />
        </div>
        <div class="grid gap-1.5">
          <Label htmlFor="lens-name">Name (optional)</Label>
          <Input id="lens-name" type="text" name="name" defaultValue={newName ?? ''} placeholder="Defaults to the search" maxLength={60} />
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button type="submit">Save lens</Button>
          <a class="text-sm text-muted-foreground" href={home}>Cancel</a>
        </div>
        <p class="m-0 text-sm text-muted-foreground">
          Every member sees this lens. It matches by meaning as well as words, across
          everything shared to the group.
        </p>
      </form>
    )
  }

  {
    sections.map(({ lens, links, total, error: sectionError }) => (
      <section id={`lens-${lens.id}`} class="mt-6 scroll-mt-4">
        <div class="flex items-start gap-2">
          <div class="min-w-0 flex-1">
            <h3 class="m-0 text-[1.1rem] wrap-anywhere">
              {single ? (
                lens.name
              ) : (
                <a class="text-foreground no-underline hover:underline" href={withView(`${home}?lens=${lens.id}`)}>
                  {lens.name}
                </a>
              )}
            </h3>
            <p class="m-0 mt-1 text-sm text-muted-foreground">
              Searching for “{lens.query}” · {countLabel(total)}
            </p>
          </div>
          {ownerView && <LensMenu client:visible lensId={lens.id} name={lens.name} query={lens.query} inGroup />}
        </div>
        {sectionError && <Alert variant="error">{sectionError}</Alert>}
        {links.length === 0 && !sectionError ? (
          <Empty>Nothing shared here matches yet.</Empty>
        ) : (
          <CardList>
            {links.map((l) => (
              <PoolCard link={l} groupId={group.id} isOwner={ownerView} returnPath={returnPath} snippetLines={single ? 3 : 2} />
            ))}
          </CardList>
        )}
        {!single && total > links.length && (
          <a class="text-sm font-semibold" href={withView(`${home}?lens=${lens.id}`)}>
            See all {countLabel(total)} →
          </a>
        )}
      </section>
    ))
  }

  {!single && ownerView && !formOpen && <TopicSuggestions client:load groupId={group.id} home={home} />}

  {
    !single && (
      <>
        <h2 class="mt-10">Shared this week</h2>
        {recent.error && <Alert variant="error">{recent.error}</Alert>}
        {recent.links.length === 0 && !recent.error ? (
          <Empty>
            Nothing shared in the last {RECENT_DAYS} days. Share a save from your{' '}
            <a href="/">archive</a> with a note of why.
          </Empty>
        ) : (
          <>
            {recentNew.length > 0 && (
              <>
                <p class="m-0 mt-3 text-sm font-semibold">New since your last visit</p>
                <CardList>
                  {recentNew.map((l) => (
                    <PoolCard link={l} groupId={group.id} isOwner={ownerView} returnPath={returnPath} />
                  ))}
                </CardList>
                {recentEarlier.length > 0 && (
                  <p class="m-0 mt-6 border-t-2 border-dashed pt-3 text-sm font-semibold text-muted-foreground">
                    Seen before
                  </p>
                )}
              </>
            )}
            {recentEarlier.length > 0 && (
              <CardList>
                {recentEarlier.map((l) => (
                  <PoolCard link={l} groupId={group.id} isOwner={ownerView} returnPath={returnPath} />
                ))}
              </CardList>
            )}
          </>
        )}
        <p class="text-sm text-muted-foreground">
          Older shares are in <a href={`${home}/export`}>Export</a>, by date.
        </p>
      </>
    )
  }

  {
    !single && (
      <>
        <h2 class="mt-10">Your name here</h2>
        <p class="text-sm text-muted-foreground">
          Optional. Shown on what you share, in this group only — a nickname is fine. Leave it
          blank to stay anonymous; your email is never shown.
        </p>
        <form class="mt-3 mb-6 flex flex-wrap gap-2.5" method="post">
          <input type="hidden" name="_action" value="nickname" />
          <Input className="w-auto flex-1" type="text" name="display_name" defaultValue={myName} maxLength={40} placeholder="Anonymous" aria-label="Your name in this group" />
          <Button variant="outline" type="submit">Save</Button>
        </form>
      </>
    )
  }

  {
    !single && ownerView && (
      <OwnerPanel title="Owner tools" id="owner-tools" className="mt-12">
        <p class="m-0 mt-2 text-sm text-muted-foreground">
          Members never see this section, or the Remove buttons and lens menus above.{' '}
          <a href={`${home}?view=member`}>Preview as a member</a>
        </p>
        <h3 class="mt-6 text-[1.1rem]">Invite link</h3>
        {invite ? (
          <>
            <code class="block rounded-md border-2 border-dashed bg-background p-2.5 text-[0.88rem] wrap-anywhere select-all">{`${Astro.url.origin}/join/${invite.token}`}</code>
            {invite.paused_at && (
              <p class="text-[0.82rem] text-muted-foreground">
                Paused: it reached its weekly limit and starts working again within a week.
              </p>
            )}
          </>
        ) : (
          <p>No active invite link.</p>
        )}
        <form class="mt-2" method="post">
          <input type="hidden" name="_action" value="rotate_invite" />
          <Button variant="outline" type="submit">
            {invite ? 'New link (the old one stops working)' : 'Create invite link'}
          </Button>
        </form>

        {removedLinks.length > 0 && (
          <>
            <h3 class="mt-8 text-[1.1rem]">Removed links</h3>
            <p class="text-sm text-muted-foreground">
              Hidden from the group and can't be shared here again. Members keep them in their
              archives. Restoring brings back the shares that were removed.
            </p>
            <CardList>
              {removedLinks.map((r) => (
                <ItemCard href={r.canonical_url} title={r.title ?? r.canonical_url}>
                  <Fragment slot="meta">Removed {dateFmt.format(new Date(r.removed_at))}</Fragment>
                  <form slot="action" method="post">
                    <input type="hidden" name="_action" value="restore_link" />
                    <input type="hidden" name="link_id" value={r.link_id} />
                    <Button variant="outline" size="sm" type="submit">Restore</Button>
                  </form>
                </ItemCard>
              ))}
            </CardList>
          </>
        )}

        <h3 class="mt-8 text-[1.1rem]">Group name</h3>
        <form class="mt-3 flex flex-wrap gap-2.5" method="post">
          <input type="hidden" name="_action" value="rename" />
          <Input className="w-auto flex-1" type="text" name="name" defaultValue={group.name} maxLength={100} aria-label="Group name" />
          <Button variant="outline" type="submit">Rename</Button>
        </form>
      </OwnerPanel>
    )
  }

  {
    !single && preview && (
      <div class="mt-10">
        <Button variant="destructive" type="button" disabled>Leave group</Button>
        <p class="mt-2 text-sm text-muted-foreground">Members can leave from here. You run the group, so it's off for you.</p>
      </div>
    )
  }

  {
    !single && !isOwner && (
      <form class="mt-10" method="post" onsubmit="return confirm('Leave the group? Your shares to it are removed; your saves stay in your archive.')">
        <input type="hidden" name="_action" value="leave" />
        <Button variant="destructive" type="submit">
          Leave group
        </Button>
      </form>
    )
  }
</Layout>
