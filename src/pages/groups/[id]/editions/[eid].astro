---
import Layout from '../../../../layouts/Layout.astro';
import ItemCard from '@/components/ItemCard.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import Why from '@/components/Why.astro';
import { LABEL_TEXT } from '../../../../lib/editionEmail';
import { groupsEnabled } from '../../../../lib/flags';

if (!groupsEnabled()) {
  return Astro.redirect('/');
}

type LabelVariant = 'hot' | 'first_time' | 'small_source' | 'rising';
const LABEL_VARIANTS: readonly string[] = ['hot', 'first_time', 'small_source', 'rising'];
const labelVariant = (label: string): LabelVariant =>
  LABEL_VARIANTS.includes(label) ? (label as LabelVariant) : 'hot';

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const groupId = Astro.params.id!;
const editionId = Astro.params.eid!;

// RLS: members only.
const [{ data: edition }, { data: group }] = await Promise.all([
  supabase
    .from('editions')
    .select('id, group_id, period_start, period_end, published_at, active_members')
    .eq('id', editionId)
    .eq('group_id', groupId)
    .maybeSingle(),
  supabase.from('groups').select('id, name, names_visible').eq('id', groupId).maybeSingle(),
]);

if (!edition || !group) {
  return Astro.redirect('/groups');
}

const { data: links } = await supabase
  .from('edition_links')
  .select('position, label, link_id, title, canonical_url, source, notes, recommender_names, attribution_names, recommender_count')
  .eq('edition_id', edition.id)
  .order('position');

type EntryRow = {
  position: number;
  label: string;
  link_id: string;
  title: string | null;
  canonical_url: string;
  source: string | null;
  notes: string[];
  recommender_names: string[];
  attribution_names: string[];
  recommender_count: number;
};
const entries = (links ?? []) as unknown as EntryRow[];

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const periodLabel = `${dateFmt.format(new Date(edition.period_start))} – ${dateFmt.format(
  new Date(edition.period_end)
)}`;

// Roundup export (PLAN.md Phase 2): markdown with blurbs and opt-in attribution.
if (Astro.url.searchParams.get('format') === 'markdown') {
  const lines: string[] = [`# ${group.name}: ${periodLabel}`, ''];
  for (const e of entries) {
    lines.push(`## ${e.title ?? e.canonical_url}`);
    lines.push('');
    lines.push(`<${e.canonical_url}>`);
    lines.push('');
    lines.push(`*${LABEL_TEXT[e.label] ?? e.label}* · recommended by ${e.recommender_count} reader${e.recommender_count === 1 ? '' : 's'}${e.attribution_names.length ? ` (${e.attribution_names.join(', ')})` : ''}`);
    for (const s of e.notes) {
      lines.push('');
      lines.push(`> ${s}`);
    }
    lines.push('');
  }
  return new Response(lines.join('\n'), {
    headers: {
      'Content-Type': 'text/markdown; charset=utf-8',
      'Content-Disposition': `attachment; filename="edition-${edition.period_start.slice(0, 10)}.md"`,
    },
  });
}
---

<Layout title={`${group.name} — ${periodLabel}`} user={user}>
  <h1>{group.name}</h1>
  <p class="text-[0.82rem] text-muted-foreground">
    {periodLabel} · {entries.length} link{entries.length === 1 ? '' : 's'} · that's all of them
  </p>

  <p><a href={`/groups/${groupId}/editions/${editionId}?format=markdown`}>Export as markdown (roundup draft)</a></p>

  <CardList>
    {
      entries.map((e) => (
        <ItemCard href={e.canonical_url} title={e.title ?? e.canonical_url}>
          <Badge slot="before" variant={labelVariant(e.label)} className="mb-1">{LABEL_TEXT[e.label] ?? e.label}</Badge>
          <Fragment slot="meta">
            {e.source ?? ''} · {e.recommender_count} reader{e.recommender_count === 1 ? '' : 's'}
            {group.names_visible && e.recommender_names.length > 0
              ? ` · ${e.recommender_names.join(', ')}`
              : ''}
          </Fragment>
          {e.notes.map((s) => (
            <Why>“{s}”</Why>
          ))}
          <form method="post" action="/api/flags">
            <input type="hidden" name="link_id" value={e.link_id} />
            <input type="hidden" name="back" value={`/groups/${groupId}/editions/${editionId}`} />
            <Button variant="outline" size="sm" type="submit">
              Flag
            </Button>
          </form>
        </ItemCard>
      ))
    }
  </CardList>

  <Empty>When you've seen them, you're done.</Empty>
</Layout>
