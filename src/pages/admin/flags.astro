---
import Layout from '../../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import { createServiceClient } from '../../lib/supabase';

// Flag-and-review queue (PLAN.md §9). Admin = emails in ADMIN_EMAILS.
const { user } = Astro.locals;
const admins = (import.meta.env.ADMIN_EMAILS ?? '')
  .split(',')
  .map((e: string) => e.trim().toLowerCase())
  .filter(Boolean);

if (!user || !admins.includes((user.email ?? '').toLowerCase())) {
  return new Response('Not found', { status: 404 });
}

const service = createServiceClient();
let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action'));
  const flagId = String(form.get('flag_id'));
  const linkId = String(form.get('link_id'));

  if (action === 'hold') {
    await service.from('links').update({ status: 'held' }).eq('id', linkId);
    await service.from('flags').update({ resolved_at: new Date().toISOString() }).eq('id', flagId);
    message = 'Link held: it will not surface in groups, editions, or the public layer.';
  }
  if (action === 'dismiss') {
    await service.from('flags').update({ resolved_at: new Date().toISOString() }).eq('id', flagId);
    message = 'Flag dismissed.';
  }
  if (action === 'unhold') {
    await service.from('links').update({ status: 'ready' }).eq('id', linkId);
    message = 'Link released.';
  }
}

const { data: open } = await service
  .from('flags')
  .select('id, reason, created_at, link_id, links(title, canonical_url, source, status)')
  .is('resolved_at', null)
  .order('created_at');

type FlagRow = {
  id: string;
  reason: string;
  created_at: string;
  link_id: string;
  links: { title: string | null; canonical_url: string; source: string | null; status: string } | null;
};
const flags = (open ?? []) as unknown as FlagRow[];
---

<Layout title="Flags — Radar" user={user}>
  <h1>Flag queue</h1>
  {message && <Alert>{message}</Alert>}

  {
    flags.length === 0 ? (
      <Empty>Nothing flagged. Good.</Empty>
    ) : (
      <CardList>
        {flags.map((f) => (
          <ItemCard href={f.links?.canonical_url} title={f.links?.title ?? f.links?.canonical_url}>
            <Fragment slot="meta">
              {f.links?.source ?? ''} · status: {f.links?.status} · flagged {f.created_at.slice(0, 10)}
            </Fragment>
            {f.reason && <p class="m-0 text-[0.9rem] whitespace-pre-wrap text-muted-foreground">{f.reason}</p>}
            <div class="flex flex-wrap gap-2">
              <form method="post">
                <input type="hidden" name="_action" value="hold" />
                <input type="hidden" name="flag_id" value={f.id} />
                <input type="hidden" name="link_id" value={f.link_id} />
                <Button variant="destructive" type="submit">Hold link</Button>
              </form>
              <form method="post">
                <input type="hidden" name="_action" value="dismiss" />
                <input type="hidden" name="flag_id" value={f.id} />
                <input type="hidden" name="link_id" value={f.link_id} />
                <Button variant="outline" type="submit">Dismiss</Button>
              </form>
              {f.links?.status === 'held' && (
                <form method="post">
                  <input type="hidden" name="_action" value="unhold" />
                  <input type="hidden" name="flag_id" value={f.id} />
                  <input type="hidden" name="link_id" value={f.link_id} />
                  <Button variant="outline" type="submit">Release</Button>
                </form>
              )}
            </div>
          </ItemCard>
        ))}
      </CardList>
    )
  }
</Layout>
