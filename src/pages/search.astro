---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import SaveMenu from '@/components/SaveMenu.tsx';
import Why from '@/components/Why.astro';
import { embedTexts, embeddingsConfigured } from '../lib/embeddings';
import { sanitizeSnippet } from '../lib/snippet';

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const q = (Astro.url.searchParams.get('q') ?? '').trim();

// Confirmations after a menu action round-trips back here.
const updated = Astro.url.searchParams.get('updated') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const actionError = Astro.url.searchParams.get('error');

interface Result {
  save_id: string;
  title: string | null;
  canonical_url: string;
  source: string | null;
  snippet: string;
  note: string | null;
  created_at: string;
  rank: number;
}

let results: Result[] = [];
let searchError: string | null = null;

if (q) {
  let queryEmbedding: number[] | null = null;
  if (embeddingsConfigured()) {
    try {
      [queryEmbedding] = await embedTexts([q]);
    } catch {
      // Keyword search still works without the embedding.
    }
  }
  const { data, error } = await supabase.rpc('search_archive', {
    query: q,
    query_embedding: queryEmbedding,
    match_limit: 30,
  });
  if (error) searchError = error.message;
  results = (data ?? []) as Result[];
}

function displayTitle(r: Result): string {
  if (r.title) return r.title;
  try {
    const u = new URL(r.canonical_url);
    return u.hostname.replace(/^www\./, '') + u.pathname;
  } catch {
    return r.canonical_url;
  }
}
---

<Layout title={q ? `${q} — Search — Radar` : 'Search — Radar'} user={user}>
  <h1>Search your archive</h1>
  <form class="mt-4 mb-6 grid gap-2.5" method="get" action="/search">
    {/* Autofocus only the empty box: results pages leave focus at the top,
        and autofocusing a pre-filled input puts the caret at position 0. */}
    <Input
      type="search"
      name="q"
      defaultValue={q}
      placeholder="Words, ideas, half-remembered phrases"
      autoFocus={!q}
    />
    <Button type="submit">Search</Button>
  </form>

  {updated && <Alert>Note updated.</Alert>}
  {deleted && <Alert>Deleted.</Alert>}
  {actionError && <Alert variant="error">{actionError}</Alert>}
  {searchError && <Alert variant="error">{searchError}</Alert>}

  {
    q && !searchError && (
      results.length === 0 ? (
        <Empty>Nothing found for “{q}”.</Empty>
      ) : (
        <>
        <div class="flex flex-wrap items-baseline gap-x-3">
          <h2>
            {results.length} {results.length === 1 ? 'result' : 'results'} for “{q}”
          </h2>
          <a class="ml-auto text-sm text-muted-foreground" href={`/explore?new=${encodeURIComponent(q)}`}>
            Save as a lens →
          </a>
        </div>
        <CardList>
          {results.map((r) => (
            <ItemCard href={r.canonical_url} title={displayTitle(r)}>
              <Fragment slot="meta">{r.source ?? ''}</Fragment>
              <SaveMenu
                slot="action"
                client:visible
                saveId={r.save_id}
                title={displayTitle(r)}
                url={r.canonical_url}
                note={r.note}
                canRetry={false}
                returnPath={`/search?q=${encodeURIComponent(q)}`}
              />
              {r.snippet && <p class="m-0 text-[0.9rem] whitespace-pre-wrap text-muted-foreground" set:html={sanitizeSnippet(r.snippet)} />}
              {r.note && <Why>{r.note}</Why>}
            </ItemCard>
          ))}
        </CardList>
        </>
      )
    )
  }
</Layout>
