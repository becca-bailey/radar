---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button, buttonVariants } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { DownloadIcon } from 'lucide-react';
import Empty from '@/components/Empty.astro';
import CardList from '@/components/CardList.astro';
import { Badge, badgeVariants } from '@/components/ui/badge';
import SaveCard, { type SaveRow } from '@/components/SaveCard.astro';
import UndoDeleteAlert from '@/components/UndoDeleteAlert.astro';
import PendingSavesRefresh from '@/components/PendingSavesRefresh.astro';
import SkeletonCards from '@/components/SkeletonCards.astro';
import { RESURFACE_MIN_AGE_DAYS, agoLabel, pickForDay } from '../lib/resurface';
import { dayKey } from '../lib/dates';
import { UUID_RE, afterCursorFilter, nextPageHref, parseCursor } from '../lib/archiveCursor';
import { savesWithArchivedText } from '../lib/saves';

const { user, supabase } = Astro.locals;
if (!user) {
  // Signed out: show the landing page at the same URL.
  return Astro.rewrite('/about');
}

const saved = Astro.url.searchParams.get('saved') === '1';
const shared = Astro.url.searchParams.get('shared') === '1';
const unshared = Astro.url.searchParams.get('unshared') === '1';
const updated = Astro.url.searchParams.get('updated') === '1';
const ownWorkChanged = Astro.url.searchParams.get('own_work');
const retrying = Astro.url.searchParams.get('retrying') === '1';
// Undo targets: a save just made (delete it) or a save just deleted (restore it).
const undoSave = Astro.url.searchParams.get('undo_save');
const undoSaveId = undoSave && UUID_RE.test(undoSave) ? undoSave : null;
const removed = Astro.url.searchParams.get('removed') === '1';
const error = Astro.url.searchParams.get('error');
const topic = Astro.url.searchParams.get('topic');
// Set when paging back through older saves ("Load more").
const cursor = parseCursor(Astro.url.searchParams);
const PAGE_SIZE = 200;

// RLS scopes everything to the signed-in user.
const [{ data: categories }, { data: catRows }, { data: myGroups }, { data: profile }] =
  await Promise.all([
    supabase.from('categories').select('id, slug, name').order('id'),
    // Whole-archive category ids, for the chip counts (not just the 200 shown).
    supabase.from('saves').select('own_work, links(category_id)'),
    supabase.from('groups').select('id, name').order('created_at'),
    supabase.from('profiles').select('last_shared_group_id').eq('id', user.id).single(),
  ]);

const cats = (categories ?? []) as { id: number; slug: string; name: string }[];
const bySlug = new Map(cats.map((c) => [c.slug, c]));
const activeCat = topic && topic !== 'uncategorized' ? (bySlug.get(topic) ?? null) : null;

const linkCols = 'title, source, canonical_url, status, image:metadata->>image, fetch_blocked:metadata->>fetchBlocked';
let query = supabase
  .from('saves')
  .select(`id, original_url, note, created_at, own_work, ${topic ? 'links!inner' : 'links'}(${linkCols}), shares(group_id, removed_at, picked_at)`)
  // Your own work ("I made this") has its own section, not Recent saves.
  .eq('own_work', false);
if (topic === 'uncategorized') query = query.is('links.category_id', null);
else if (activeCat) query = query.eq('links.category_id', activeCat.id);
if (cursor) query = query.or(afterCursorFilter(cursor));
const resurfaceCutoff = new Date(Date.now() - RESURFACE_MIN_AGE_DAYS * 24 * 60 * 60 * 1000).toISOString();
const MADE_PREVIEW = 3;
const [{ data: saves }, { data: oldSaves }, { data: madeRows, count: madeCount }] = await Promise.all([
  // One extra row tells us whether there's another page.
  query
    .order('created_at', { ascending: false })
    .order('id', { ascending: false })
    .limit(PAGE_SIZE + 1),
  // Candidates for "from a while ago": only on the unfiltered first page.
  topic || cursor
    ? Promise.resolve({ data: [] })
    : supabase
        .from('saves')
        .select(`id, original_url, note, created_at, own_work, links(${linkCols}), shares(group_id, removed_at, picked_at)`)
        .eq('own_work', false)
        .lt('created_at', resurfaceCutoff)
        .order('created_at')
        .limit(365),
  // "Made by you": your newest own work, on the unfiltered first page.
  topic || cursor
    ? Promise.resolve({ data: [], count: 0 })
    : supabase
        .from('saves')
        .select(`id, original_url, note, created_at, own_work, links(${linkCols}), shares(group_id, removed_at, picked_at)`, {
          count: 'exact',
        })
        .eq('own_work', true)
        .order('created_at', { ascending: false })
        .order('id', { ascending: false })
        .limit(MADE_PREVIEW),
]);
const made = (madeRows ?? []) as unknown as SaveRow[];
const now = new Date();
// Today's pick changes at the person's midnight, not UTC's.
const resurfaced = pickForDay((oldSaves ?? []) as unknown as SaveRow[], dayKey(now, Astro.locals.timeZone));

// Chip counts from the whole archive, apart from your own work: the chips
// filter Recent saves, which leave it out.
const countByCategory = new Map<number | null, number>();
let totalSaves = 0;
let recentSaves = 0;
for (const r of (catRows ?? []) as unknown as { own_work: boolean; links: { category_id: number | null } | null }[]) {
  totalSaves++;
  if (r.own_work) continue;
  recentSaves++;
  const id = r.links?.category_id ?? null;
  countByCategory.set(id, (countByCategory.get(id) ?? 0) + 1);
}
const topicChips = cats
  .filter((c) => (countByCategory.get(c.id) ?? 0) > 0)
  .map((c) => ({ slug: c.slug, name: c.name, count: countByCategory.get(c.id) ?? 0 }))
  .sort((a, b) => b.count - a.count);
const uncategorized = countByCategory.get(null) ?? 0;
const CHIP_LIMIT = 8;
const shownChips = topicChips.slice(0, CHIP_LIMIT);
const foldedChips = topicChips.slice(CHIP_LIMIT);

const groups = (myGroups ?? []) as { id: string; name: string }[];
const defaultGroupId = profile?.last_shared_group_id ?? groups[0]?.id ?? '';

const fetched = (saves ?? []) as unknown as SaveRow[];
const rows = fetched.slice(0, PAGE_SIZE);
const lastRow = rows.at(-1);
const moreHref =
  fetched.length > PAGE_SIZE && lastRow ? nextPageHref({ createdAt: lastRow.created_at, id: lastRow.id }, topic) : null;
// Which shown saves can open in the reader view ("Read archived text").
const withText = await savesWithArchivedText(
  supabase,
  [...rows, ...made, ...(resurfaced ? [resurfaced] : [])].map((r) => r.id)
);
const chip = badgeVariants({ variant: 'chip' });

// Once there's an archive, saving mostly happens from the share sheet;
// the paste box folds into one row so the page is about reading.
const COMPACT_AFTER = 5;
const saveBoxOpen = totalSaves < COMPACT_AFTER || !!error;
const lensTopic = activeCat?.name ?? null;
---

<Layout title="Radar" user={user}>
  {
    saved && (
      <Alert>
        <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
          Saved.
          {undoSaveId && (
            <form method="post" action={`/api/saves/${undoSaveId}`}>
              <input type="hidden" name="action" value="undo_save" />
              <button class="cursor-pointer font-semibold underline" type="submit">Undo</button>
            </form>
          )}
        </span>
      </Alert>
    )
  }
  {removed && <Alert>Removed from your archive.</Alert>}

  {shared && <Alert>Shared.</Alert>}
  {unshared && <Alert>Unshared. It's still in your archive.</Alert>}
  {updated && <Alert>Note updated.</Alert>}
  {ownWorkChanged === '1' && <Alert>Marked as your own work. It's under “Made by you”.</Alert>}
  {ownWorkChanged === '0' && <Alert>Moved back to your saves.</Alert>}
  <UndoDeleteAlert />
  {retrying && <Alert>Trying to archive it again…</Alert>}
  {error && <Alert variant="error">{error}</Alert>}

  <details
    class="group/save mt-5 mb-8 rounded-lg border-2 bg-[color-mix(in_srgb,var(--peach)_22%,var(--card))] shadow-hard"
    open={saveBoxOpen}
  >
    <summary
      class:list={[
        'flex cursor-pointer list-none flex-wrap items-center justify-between gap-x-3 px-4 py-3 [&::-webkit-details-marker]:hidden',
        saveBoxOpen && 'pointer-events-none pb-0',
      ]}
      tabindex={saveBoxOpen ? -1 : undefined}
    >
      <h2 class="m-0 text-[1.15rem]">
        <span class="group-open/save:hidden" aria-hidden="true">+ </span>Save a link
      </h2>
      <a class="pointer-events-auto text-sm text-muted-foreground" href="/setup">Other ways to save →</a>
    </summary>
    <form class="grid gap-2.5 px-4 pt-2.5 pb-4" method="post" action="/api/saves">
      <Input type="url" name="url" placeholder="Paste a link to save it" required />
      <Input type="text" name="note" placeholder="Why you're saving it (optional)" />
      <label class="flex items-center gap-2 text-sm font-semibold">
        <input class="size-4 accent-primary" type="checkbox" name="own_work" value="1" />
        I made this
      </label>
      <Button type="submit">Save</Button>
    </form>
    <SkeletonCards count={1} class="px-4 pb-4" />
  </details>

  {
    resurfaced && (
      <section class="mb-8" aria-labelledby="resurfaced-heading">
        <h2 id="resurfaced-heading" class="m-0 mb-2 text-[1.15rem]">
          From {agoLabel(new Date(resurfaced.created_at), now)}
        </h2>
        <CardList>
          <SaveCard row={resurfaced} groups={groups} defaultGroupId={defaultGroupId} topic={topic} hasArchivedText={withText.has(resurfaced.id)} />
        </CardList>
        <p class="m-0 mt-1.5 text-sm text-muted-foreground">A different one tomorrow.</p>
      </section>
    )
  }

  {
    made.length > 0 && (
      <section class="mb-8" aria-labelledby="made-heading">
        <div class="mb-2 flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <h2 id="made-heading" class="m-0 text-[1.15rem]">Made by you</h2>
          <Badge className="-rotate-2">{madeCount ?? made.length}</Badge>
        </div>
        <CardList>
          {made.map((row) => (
            <SaveCard row={row} groups={groups} defaultGroupId={defaultGroupId} hideOwnWork hasArchivedText={withText.has(row.id)} />
          ))}
        </CardList>
        {(madeCount ?? 0) > made.length && (
          <a class="text-sm font-semibold" href="/made">
            See all {madeCount} →
          </a>
        )}
      </section>
    )
  }

  {
    totalSaves > 0 && (
      <div class="mt-8 mb-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <h2 class="m-0 whitespace-nowrap">Recent saves</h2>
        <Badge className="-rotate-2">{recentSaves}</Badge>
        <a class={buttonVariants({ variant: 'outline', size: 'sm', className: 'ml-auto' })} href="/export">
          <DownloadIcon aria-hidden="true" />
          Export
        </a>
      </div>
    )
  }

  {
    topicChips.length > 0 && (
      // Phones: one row that scrolls sideways, bleeding to the screen edges.
      // Wider screens: chips wrap onto as many rows as they need.
      <nav
        class="-mx-4 mt-1.5 mb-0.5 flex gap-2 overflow-x-auto px-4 pt-1 pb-2.5 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 [&::-webkit-scrollbar]:hidden"
        aria-label="Filter by topic"
      >
        <a class={chip} href="/" aria-current={!topic ? 'true' : undefined}>
          All · {recentSaves}
        </a>
        {shownChips.map((c) => (
          <a class={chip} href={`/?topic=${c.slug}`} aria-current={topic === c.slug ? 'true' : undefined}>
            {c.name} · {c.count}
          </a>
        ))}
        {foldedChips.length > 0 && (
          // display:contents keeps the folded chips flowing in the same row.
          <details class="group contents">
            <summary class:list={[chip, 'list-none text-muted-foreground group-open:hidden [&::-webkit-details-marker]:hidden']}>
              More…
            </summary>
            <div class="contents">
              {foldedChips.map((c) => (
                <a class={chip} href={`/?topic=${c.slug}`} aria-current={topic === c.slug ? 'true' : undefined}>
                  {c.name} · {c.count}
                </a>
              ))}
            </div>
          </details>
        )}
        {uncategorized > 0 && (
          <a class={chip} href="/?topic=uncategorized" aria-current={topic === 'uncategorized' ? 'true' : undefined}>
            Uncategorized · {uncategorized}
          </a>
        )}
      </nav>
    )
  }

  {
    lensTopic && (
      <p class="m-0 mt-1 mb-2 text-sm">
        <a href={`/explore?new=${encodeURIComponent(lensTopic)}`}>Keep “{lensTopic}” as a lens →</a>
        <span class="text-muted-foreground"> A lens matches by meaning, so it gathers related saves too.</span>
      </p>
    )
  }

  {
    cursor && (
      <p class="m-0 mt-2 text-sm">
        <a href={topic ? `/?topic=${encodeURIComponent(topic)}` : '/'}>← Back to the newest</a>
      </p>
    )
  }

  {
    rows.length === 0 ? (
      <Empty>
        {cursor ? (
          'No older saves.'
        ) : topic ? (
          `Nothing saved under ${activeCat?.name ?? 'that topic'} yet.`
        ) : made.length > 0 ? (
          'Links you save to read later show up here.'
        ) : (
          <>Your archive is empty. Save the first thing you don't want to lose, here or <a href="/setup">from your phone and browser</a>.</>
        )}
      </Empty>
    ) : (
      <CardList data-archive-list>
        {rows.map((row) => (
          <SaveCard row={row} groups={groups} defaultGroupId={defaultGroupId} topic={topic} hasArchivedText={withText.has(row.id)} />
        ))}
      </CardList>
    )
  }

  {
    moreHref && (
      // A plain link to the next page; the script below appends it in place instead.
      <p class="m-0 mb-8 text-center" data-archive-more>
        <a class={buttonVariants({ variant: 'outline' })} href={moreHref}>
          Load more
        </a>
      </p>
    )
  }

  <script>
    // "Load more": fetch the next page and append its cards here instead of
    // navigating. Without JS (or if the fetch fails) the link just opens it.
    let loads = 0;
    document.addEventListener('click', async (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-archive-more] a');
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) {
        return;
      }
      event.preventDefault();
      if (link.getAttribute('aria-disabled') === 'true') return;
      link.setAttribute('aria-disabled', 'true');
      try {
        const res = await fetch(link.href);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const next = new DOMParser().parseFromString(await res.text(), 'text/html');
        const list = document.querySelector('[data-archive-list]');
        const nextList = next.querySelector('[data-archive-list]');
        const control = link.closest('[data-archive-more]')!;
        if (!list) throw new Error('No list on this page');
        // Saves deleted since this page loaded can leave nothing older.
        if (!nextList) {
          control.remove();
          return;
        }
        // Every render numbers React useId prefixes from r0; make the new
        // islands' prefixes unique so their generated ids don't collide.
        loads++;
        for (const island of nextList.querySelectorAll('astro-island[prefix]')) {
          island.setAttribute('prefix', `p${loads}${island.getAttribute('prefix')}`);
        }
        const firstNew = nextList.firstElementChild;
        list.append(...nextList.children);
        const nextControl = next.querySelector('[data-archive-more]');
        if (nextControl) control.replaceWith(nextControl);
        else control.remove();
        // Keep keyboard focus in the list rather than losing it with the button.
        firstNew?.querySelector<HTMLElement>('a[href]')?.focus({ preventScroll: true });
      } catch {
        location.href = link.href;
      }
    });
  </script>

  <PendingSavesRefresh />
</Layout>
