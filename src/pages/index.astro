---
import Layout from '../layouts/Layout.astro';

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const saved = Astro.url.searchParams.get('saved') === '1';
const shared = Astro.url.searchParams.get('shared') === '1';
const error = Astro.url.searchParams.get('error');

// RLS scopes this to the signed-in user's saves.
const [{ data: saves }, { data: myGroups }, { data: profile }] = await Promise.all([
  supabase
    .from('saves')
    .select('id, original_url, note, created_at, links(title, source, canonical_url, status)')
    .order('created_at', { ascending: false })
    .limit(200),
  supabase.from('groups').select('id, name').order('created_at'),
  supabase.from('profiles').select('last_shared_group_id').eq('id', user.id).single(),
]);

const groups = (myGroups ?? []) as { id: string; name: string }[];
const defaultGroupId = profile?.last_shared_group_id ?? groups[0]?.id ?? '';

type SaveRow = {
  id: string;
  original_url: string;
  note: string | null;
  created_at: string;
  links: {
    title: string | null;
    source: string | null;
    canonical_url: string;
    status: string;
  } | null;
};

const rows = (saves ?? []) as unknown as SaveRow[];

function displayTitle(row: SaveRow): string {
  if (row.links?.title) return row.links.title;
  try {
    const u = new URL(row.links?.canonical_url ?? row.original_url);
    return u.hostname.replace(/^www\./, '') + u.pathname;
  } catch {
    return row.original_url;
  }
}

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="Radar" user={user}>
  {saved && <div class="notice">Saved.</div>}
  {shared && <div class="notice">Shared.</div>}
  {error && <div class="notice error">{error}</div>}

  <form class="stack" method="post" action="/api/saves">
    <input type="url" name="url" placeholder="Paste a link to save it" required />
    <input type="text" name="note" placeholder="Why you're saving it (optional, shown if shared)" />
    <button type="submit">Save</button>
  </form>

  {
    rows.length === 0 ? (
      <p class="empty">Your archive is empty. Save the first thing you don't want to lose.</p>
    ) : (
      <ul class="saves">
        {rows.map((row) => (
          <li data-save-id={row.id} data-pending={row.links?.status === 'pending' ? '' : undefined}>
            <a class="title" href={row.links?.canonical_url ?? row.original_url}>
              {displayTitle(row)}
            </a>
            <div class="meta">
              {row.links?.source ?? ''}
              {row.links?.source ? ' · ' : ''}
              {dateFmt.format(new Date(row.created_at))}
              {row.links?.status === 'pending' ? ' · archiving…' : ''}
              {row.links?.status === 'failed' ? " · couldn't archive, saved the link" : ''}
            </div>
            {row.note && <p class="why">{row.note}</p>}
            {groups.length > 0 && (
              <details style="margin-top:0.5rem">
                <summary style="cursor:pointer; font-size:0.85rem; color:var(--muted)">Share…</summary>
                <form class="stack" method="post" action="/api/recommendations" style="margin:0.5rem 0 0">
                  <input type="hidden" name="save_id" value={row.id} />
                  <select name="group_id">
                    {groups.map((g) => (
                      <option value={g.id} selected={g.id === defaultGroupId}>
                        {g.name}
                      </option>
                    ))}
                  </select>
                  <input
                    type="text"
                    name="note"
                    value={row.note ?? ''}
                    placeholder="Why you're recommending it (the group sees this)"
                  />
                  <label style="font-size:0.85rem">
                    <input type="checkbox" name="attribution_ok" /> OK to credit me by name in a published
                    roundup
                  </label>
                  <button class="quiet" type="submit">Share</button>
                </form>
              </details>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <script>
    // While any save is still archiving, poll its status and re-render the
    // page when the worker finishes (or gives up), instead of making the
    // user refresh. Gives up after two minutes; a plain refresh still works.
    const pending = [...document.querySelectorAll<HTMLElement>('li[data-pending]')].map(
      (el) => el.dataset.saveId as string
    );
    if (pending.length > 0) {
      // No cron runs locally, so in dev the page kicks the queue itself.
      // In production this 401s harmlessly; the scheduled function does it.
      if (import.meta.env.DEV) {
        fetch('/api/jobs/ingest?limit=10', { method: 'POST' }).catch(() => {});
      }
      const deadline = Date.now() + 2 * 60_000;
      const tick = async () => {
        try {
          const res = await fetch('/api/saves/status?ids=' + pending.join(','));
          if (res.ok) {
            const statuses: Record<string, string> = await res.json();
            if (pending.some((id) => statuses[id] && statuses[id] !== 'pending')) {
              location.reload();
              return;
            }
          }
        } catch {
          // Transient network error; try again on the next tick.
        }
        if (Date.now() < deadline) setTimeout(tick, 2500);
      };
      setTimeout(tick, 2500);
    }
  </script>
</Layout>
