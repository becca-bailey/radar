---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import CardList from '@/components/CardList.astro';
import ItemCard from '@/components/ItemCard.astro';
import TokenReveal from '../components/TokenReveal.astro';
import { generateApiToken } from '../lib/apiTokens';
import { groupsEnabled } from '../lib/flags';
import { createServiceClient } from '../lib/supabase';
import { formatDate } from '../lib/dates';

const { user, supabase } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

let newToken: string | null = null;
let message: string | null = null;
// Set by /api/account/delete when it bounces back here.
const deleteError = Astro.url.searchParams.get('error');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');

  if (action === 'shortcut_note') {
    const { error } = await supabase
      .from('profiles')
      .update({ shortcut_ask_note: form.get('ask_note') === 'on' })
      .eq('id', user.id);
    message = error ? 'Could not save that setting.' : 'Shortcut setting saved.';
  }

  if (action === 'create_token') {
    const { raw, hash } = generateApiToken();
    const label = String(form.get('label') ?? '').trim() || 'Shortcut';
    const service = createServiceClient();
    const { error } = await service
      .from('api_tokens')
      .insert({ user_id: user.id, token_hash: hash, label });
    if (error) {
      message = `Could not create token: ${error.message}`;
    } else {
      newToken = raw;
    }
  }

  if (action === 'revoke_token') {
    // User-scoped client: RLS allows deleting only your own tokens.
    const { error } = await supabase.from('api_tokens').delete().eq('id', String(form.get('id')));
    message = error ? `Could not revoke: ${error.message}` : 'Token revoked.';
  }
}

const { data: prefs } = await supabase.from('profiles').select('shortcut_ask_note').eq('id', user.id).maybeSingle();
const askNote = prefs?.shortcut_ask_note !== false;
const { data: tokens } = await supabase
  .from('api_tokens')
  .select('id, label, created_at, last_used_at')
  .order('created_at', { ascending: false });

const timeZone = Astro.locals.timeZone;
---

<Layout title="Settings — Radar" user={user}>
  <h1>Settings</h1>

  {message && <Alert>{message}</Alert>}

  <h2>iPhone Shortcut</h2>
  <form class="mt-3 mb-6 grid gap-2.5" method="post">
    <input type="hidden" name="_action" value="shortcut_note" />
    <label class="flex items-start gap-2 text-sm font-semibold">
      <input class="mt-0.5 size-4 accent-primary" type="checkbox" name="ask_note" checked={askNote} />
      <span>
        Ask "why are you saving it?" each time
        <span class="block font-normal text-muted-foreground">
          Off: the Shortcut saves without a note{groupsEnabled() ? ' and only asks about groups' : ''}. You can add a note later from your archive.
        </span>
      </span>
    </label>
    <Button className="w-fit" variant="outline" type="submit">Save</Button>
  </form>

  <h2>API tokens</h2>
  <p>
    For the Radar Shortcut and anything else that saves on your behalf. A token can save
    links to your archive{groupsEnabled() ? ' and share them to your groups' : ''}. It can't read your archive.
  </p>

  {newToken && <TokenReveal token={newToken} />}

  <form class="mt-4 mb-6 grid gap-2.5" method="post">
    <input type="hidden" name="_action" value="create_token" />
    <Input type="text" name="label" placeholder="Label (e.g. iPhone Shortcut)" />
    <Button type="submit">Create token</Button>
  </form>

  {
    (tokens ?? []).length > 0 && (
      <CardList>
        {(tokens ?? []).map((t) => (
          <ItemCard title={t.label || 'Token'}>
            <Fragment slot="meta">
              Created {formatDate(t.created_at, timeZone)}
              {t.last_used_at ? ` · last used ${formatDate(t.last_used_at, timeZone)}` : ' · never used'}
            </Fragment>
            <form class="mt-2" method="post">
              <input type="hidden" name="_action" value="revoke_token" />
              <input type="hidden" name="id" value={t.id} />
              <Button variant="destructive" type="submit">
                Revoke
              </Button>
            </form>
          </ItemCard>
        ))}
      </CardList>
    )
  }

  <h2>Capture tools</h2>
  <p>
    Get Radar into your iPhone's share sheet and your desktop bookmarks bar on the{' '}
    <a href="/setup">setup page</a>. Rolling your own instead? POST to{' '}
    <code>{Astro.url.origin}/api/saves</code> with header{' '}
    <code>Authorization: Bearer &lt;your token&gt;</code> and JSON body{' '}
    <code>{'{"url": "…", "note": "…", "title": "…"}'}</code> (note and title optional).
  </p>

  <h2>Export</h2>
  <p>Your whole archive, any time: <a href="/api/export?format=markdown">Markdown</a> · <a href="/api/export?format=json">JSON</a></p>
  <p>Or <a href="/export">pick specific saves</a> by date and export just those.</p>

  <h2 id="delete-account">Delete your account</h2>
  <p>
    Permanently deletes your account, every save and note, your lenses and your API
    tokens{groupsEnabled() ? ', and your group memberships. Groups you own are deleted for everyone' : ''}.
    Archived pages that nobody else saved are deleted too. This can't be undone, so <a href="/api/export?format=markdown">export your archive</a> first if you want to keep it.
  </p>
  {deleteError && <Alert variant="error">{deleteError}</Alert>}
  <form
    class="mt-4 mb-6 grid gap-2.5 rounded-lg border-2 border-destructive p-4"
    method="post"
    action="/api/account/delete"
  >
    <label class="grid gap-1.5 text-sm font-semibold" for="confirm-delete">
      Type “delete” to confirm
      <Input
        id="confirm-delete"
        type="text"
        name="confirm"
        autoComplete="off"
        required
        pattern="[Dd][Ee][Ll][Ee][Tt][Ee]"
        title="Type delete to confirm"
      />
    </label>
    <Button variant="destructive" type="submit">
      Delete my account
    </Button>
  </form>
</Layout>
