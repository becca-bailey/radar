---
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import TokenReveal from '../components/TokenReveal.astro';
import { Alert } from '@/components/ui/alert';
import { generateApiToken } from '../lib/apiTokens';
import { createServiceClient } from '../lib/supabase';
import { detectPlatform, methodOrder, type SaveMethod } from '../lib/platform';
import { OFFLINE_LIMIT } from '../lib/offline';

// Guided capture setup: get Radar into the iOS and Android share sheets and
// the desktop bookmarks bar without asking anyone to build anything.
const { user } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

let newToken: string | null = null;
let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'create_token') {
    const { raw, hash } = generateApiToken();
    const service = createServiceClient();
    const { error } = await service
      .from('api_tokens')
      .insert({ user_id: user.id, token_hash: hash, label: 'iPhone Shortcut' });
    if (error) {
      message = `Could not create token: ${error.message}`;
    } else {
      newToken = raw;
    }
  }
}

const shortcutHref = '/Put%20it%20on%20Radar.shortcut';

// Each method gets its own section; the one for the visitor's platform goes
// first. All are always rendered, only the order changes.
const order = methodOrder(detectPlatform(Astro.request.headers.get('user-agent')));
const methodLabels: Record<SaveMethod, string> = {
  shortcut: 'iPhone & iPad',
  bookmarklet: 'Desktop browsers',
  android: 'Android',
};
---

<Layout title="Save from anywhere — Radar" user={user}>
  <h1>Save from anywhere</h1>
  <p>
    Two minutes of setup and any page is one tap from your archive. Radar fetches the
    title and details itself, so saving is just handing it the link.
  </p>

  {message && <Alert>{message}</Alert>}

  <nav class="text-sm text-muted-foreground" aria-label="Save methods">
    Jump to:{' '}
    <ul class="inline-flex list-none flex-wrap gap-x-4 p-0" data-method-list>
      {
        order.map((method) => (
          <li data-method={method}>
            <a href={`#${method}`}>{methodLabels[method]}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div data-method-list>
    {
      order.map((method) =>
        method === 'shortcut' ? (
          <section id="shortcut" data-method="shortcut">
            <h2>{methodLabels.shortcut}</h2>
            <p>
              The Radar Shortcut puts <strong>Put it on Radar</strong> in the share sheet of every
              app — Safari, YouTube, anywhere you can tap Share.
            </p>
            <ol class="grid gap-2.5">
              <li>
                Create a token for your phone. It can save links to your archive and share them to your groups.
                It can't read your archive.
                {
                  newToken ? (
                    <TokenReveal token={newToken} />
                  ) : (
                    <form class="mt-2" method="post" action="/setup#shortcut">
                      <input type="hidden" name="_action" value="create_token" />
                      <Button type="submit">Create token</Button>
                    </form>
                  )
                }
              </li>
              <li>
                With the token copied, <a href={shortcutHref}>get the Radar Shortcut</a>. Safari
                downloads it: tap the <strong>↓</strong> button by the address bar, then tap{' '}
                <strong>Put it on Radar</strong>, then <strong>Add Shortcut</strong>.
              </li>
              <li>
                When Shortcuts asks for your Radar API token — as you add it, or on your first
                save — paste the token from step 1.
              </li>
            </ol>
            <p>
              That's it. To save a page, tap <strong>Share → Put it on Radar</strong>. It asks why
              you're saving it (skip it if you like), and if you're in any groups, which to share it to. Pick none to just save. Try one now and it will appear on your <a href="/">home page</a> within a minute.
            </p>
            <p class="text-sm text-muted-foreground">
              On a Mac, the same file works: double-click it and the shortcut appears in the
              share menu there too.
            </p>
          </section>
        ) : method === 'android' ? (
          <section id="android" data-method="android">
            <h2>{methodLabels.android}</h2>
            <p>
              Install Radar as an app and <strong>Radar</strong> appears in the share sheet of every
              app: Chrome, YouTube, anywhere you can tap Share. No token needed: it uses this sign-in.
            </p>
            <Button type="button" className="mb-3 hidden" data-install>
              Install Radar
            </Button>
            <ol class="grid gap-2.5">
              <li>
                Open Radar in Chrome on your phone and sign in.
              </li>
              <li>
                Tap Chrome's <strong>⋮</strong> menu, then <strong>Add to Home screen</strong> or{' '}
                <strong>Install app</strong>, and confirm.
              </li>
              <li>
                To save a page, tap <strong>Share → Radar</strong>. Radar opens with the link filled in.
                Add why you're saving it if you like, then tap <strong>Save</strong>.
              </li>
            </ol>
            <p class="text-sm text-muted-foreground">
              Other Android browsers that can install web apps work too; the menu wording varies.
            </p>
          </section>
        ) : (
          <section id="bookmarklet" data-method="bookmarklet">
            <h2>{methodLabels.bookmarklet}</h2>
            <p>
              Drag this to your bookmarks bar, then click it on any page to save it:{' '}
              <a
                href={`javascript:window.open('${Astro.url.origin}/save?url='+encodeURIComponent(location.href)+'&title='+encodeURIComponent(document.title),'radar','width=480,height=560')`}
              >Put it on Radar</a>
            </p>
            <p class="text-sm text-muted-foreground">
              On a Mac, the Radar Shortcut also works from the share menu.{' '}
              <a href="#shortcut">Set it up with the iPhone steps</a>.
            </p>
          </section>
        ),
      )
    }
  </div>

  <section id="offline">
    <h2>Read offline</h2>
    <p>
      On each phone or computer where you're signed in, Radar keeps your {OFFLINE_LIMIT} most recent saves
      that have archived text, so they open without a connection. When Radar can't be reached it shows{' '}
      <a href="/offline">what's on this device</a>. Images still need a connection. Signing out removes
      the copies.
    </p>
  </section>

  <p class="text-sm text-muted-foreground">
    Tokens can be reviewed and revoked any time in <a href="/settings">Settings</a>.
  </p>
</Layout>

<script>
  // Chrome on Android offers its own install prompt; show a button for it
  // when it's available (not yet installed, supported browser).
  const install = document.querySelector<HTMLButtonElement>('[data-install]');
  let prompt: (Event & { prompt(): Promise<void> }) | null = null;
  addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    prompt = event as typeof prompt;
    install?.classList.remove('hidden');
  });
  install?.addEventListener('click', async () => {
    if (!prompt) return;
    await prompt.prompt();
    prompt = null;
    install.classList.add('hidden');
  });
  addEventListener('appinstalled', () => install?.classList.add('hidden'));

  // iPadOS Safari sends a Mac user agent, so the server puts the bookmarklet
  // first. A touch-capable "Mac" is an iPad: move the Shortcut back to the top.
  const isIpad = /Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1;
  if (isIpad) {
    for (const list of document.querySelectorAll('[data-method-list]')) {
      const shortcut = list.querySelector(':scope > [data-method="shortcut"]');
      if (shortcut && list.firstElementChild !== shortcut) list.prepend(shortcut);
    }
    // The browser already scrolled to any #anchor (e.g. #shortcut after
    // creating a token) before this ran; scroll again now the section moved.
    if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
  }
</script>
