---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { sharedPage } from '../lib/shareTarget';

// Bookmarklet and Android share target (manifest.webmanifest): a small
// prefilled save form that works in a popup or the installed app.
const { user } = Astro.locals;
if (!user) {
  // Come back to the same shared link after signing in.
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}

// Android apps put the link in `url` or somewhere in `text`.
const { url, title } = sharedPage(Astro.url.searchParams);
const done = Astro.url.searchParams.get('done') === '1';
const already = Astro.url.searchParams.get('already') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Save — Radar" user={user}>
  {
    done ? (
      <>
        <Alert>{already ? 'Already on Radar.' : 'Saved to Radar.'} You can close this window.</Alert>
        {/* The installed app (Android share target) may not let a page close itself. */}
        <p class="text-sm"><a href="/">Go to your archive</a></p>
        <script is:inline>
          setTimeout(() => window.close(), 1200);
        </script>
      </>
    ) : (
      <>
        <h1>Save{title ? `: ${title}` : ''}</h1>
        {error && <Alert variant="error">{error}</Alert>}
        <form class="mt-4 mb-6 grid gap-2.5" method="post" action="/api/saves">
          <input type="hidden" name="return_to" value="save" />
          <input type="hidden" name="title" value={title} />
          <Input type="url" name="url" defaultValue={url} placeholder="https://…" required />
          <Input type="text" name="note" placeholder="Why you're saving it (optional)" autoFocus={!!url} />
          <Button type="submit">Save</Button>
        </form>
      </>
    )
  }
</Layout>
