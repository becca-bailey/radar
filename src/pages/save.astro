---
import Layout from '../layouts/Layout.astro';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';

// Bookmarklet target: a small prefilled save form that works in a popup.
const { user } = Astro.locals;
if (!user) {
  return Astro.redirect('/login');
}

const url = Astro.url.searchParams.get('url') ?? '';
const title = Astro.url.searchParams.get('title') ?? '';
const done = Astro.url.searchParams.get('done') === '1';
---

<Layout title="Save — Radar" user={user}>
  {
    done ? (
      <>
        <Alert>Saved. You can close this window.</Alert>
        <script is:inline>
          setTimeout(() => window.close(), 1200);
        </script>
      </>
    ) : (
      <>
        <h1>Save{title ? `: ${title}` : ''}</h1>
        <form class="mt-4 mb-6 grid gap-2.5" method="post" action="/api/saves">
          <input type="hidden" name="return_to" value="save" />
          <input type="hidden" name="title" value={title} />
          <Input type="url" name="url" defaultValue={url} placeholder="https://…" required />
          <Input type="text" name="note" placeholder="Why you saved it (optional)" autoFocus={!!url} />
          <label class="flex items-center gap-2 text-sm font-semibold">
            <input class="size-4 accent-primary" type="checkbox" name="wayback" /> Also save to the Wayback Machine
          </label>
          <Button type="submit">Save</Button>
        </form>
      </>
    )
  }
</Layout>
